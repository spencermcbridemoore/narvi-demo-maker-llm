# Copy this file to `.env` and fill in values. `.env` is git-ignored — never
# commit secrets.

# Which PROVIDER profile (in app/llm/models.yaml) to use: azure | ollama | openai.
# Provider and environment are orthogonal — this just picks where inference runs.
# `ollama` needs no secrets; the deterministic template fallbacks mean the app
# still runs even if the chosen provider is unreachable.
LLM_PROFILE=azure

# --- Azure OpenAI (when LLM_PROFILE=azure) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Use a recent api-version. 2024-10-21 (GA) covers gpt-4o/gpt-4o-mini. For
# gpt-5 / o-series reasoning deployments use 2024-12-01-preview or later.
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_VERSION=2024-10-21
# Your Azure DEPLOYMENT NAMES per tier (what you named them in the portal).
# They can all point at one deployment if you only made one.
AZURE_DEPLOYMENT_CHEAP=gpt-4o-mini
AZURE_DEPLOYMENT_MID=gpt-4o-mini
AZURE_DEPLOYMENT_STRONG=gpt-4o

# --- Ollama (when LLM_PROFILE=ollama) ---
# No secrets needed. Pull models first, e.g. `ollama pull qwen2.5-coder:7b`.
# Default endpoint shown; uncomment to override.
# OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI-compatible (when LLM_PROFILE=openai) ---
# For OpenAI itself, vLLM, LM Studio, etc. base_url is set in models.yaml.
# OPENAI_API_KEY=

# --- Server ---
# Comma-separated origins allowed to call the backend (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Override the SQLite checkpoint file location if you like.
# CHECKPOINT_DB=backend/app/data/checkpoints.sqlite

# Agent label shown by the backend /health endpoints (cosmetic).
# AGENT_NAME=demobuilder

# --- Frontend (optional) ---
# If the backend runs somewhere other than http://localhost:8000, set this in
# frontend/.env.local instead of here:
#   VITE_BACKEND_URL=http://localhost:8000

# --- Deployment (deploy/docker-compose.yml only; ignored by local run.py) ---
# See deploy/README.md. The Caddy edge reads SITE_ADDRESS + ACME_EMAIL; the
# production frontend is built same-origin (frontend/.env.production), so set
# ALLOWED_ORIGINS above to your public https origin.
#   SITE_ADDRESS  — production: a real hostname (auto Let's Encrypt cert), e.g.
#                   demobuilder.example.org or <dashed-floating-ip>.sslip.io.
#                   local compose test: ":80" (plain HTTP, no ACME).
#   ACME_EMAIL    — Let's Encrypt account email.
# SITE_ADDRESS=demobuilder.example.org
# ACME_EMAIL=you@example.org
